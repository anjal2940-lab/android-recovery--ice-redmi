# Logical/Dynamic Images (Unlocks the "Install Image" Option)
/system          ext4    system       flags=display="System";logical;slotselect;backup=1
/system_image    emmc    system       flags=display="System Image";logical;slotselect;backup=1;flashimg=1
/vendor          ext4    vendor       flags=display="Vendor";logical;slotselect;backup=1
/vendor_image    emmc    vendor       flags=display="Vendor Image";logical;slotselect;backup=1;flashimg=1
/product         ext4    product      flags=display="Product";logical;slotselect;backup=1
/product_image   emmc    product      flags=display="Product Image";logical;slotselect;backup=1;flashimg=1

# Core Firmware Images
/metadata        ext4    /dev/block/by-name/md_udc           flags=display="Metadata";backup=1
/boot            emmc    /dev/block/by-name/boot             flags=display="Boot";slotselect;backup=1;flashimg=1
/dtbo            emmc    /dev/block/by-name/dtbo             flags=display="DTBO";backup=1;flashimg=1
/vbmeta          emmc    /dev/block/by-name/vbmeta           flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system   emmc    /dev/block/by-name/vbmeta_system    flags=display="VBMeta System";slotselect;backup=1;flashimg=1
/vbmeta_vendor   emmc    /dev/block/by-name/vbmeta_vendor    flags=display="VBMeta Vendor";slotselect;backup=1;flashimg=1
/logo            emmc    /dev/block/by-name/logo             flags=display="Logo";backup=1;flashimg=1
/misc            emmc    /dev/block/by-name/misc             flags=display="Misc";backup=1;flashimg=1

# Storage, NVRAM & Calibration Hardware Elements
/persist         ext4    /dev/block/by-name/persist          flags=display="Persist";backup=1
/persist_image   emmc    /dev/block/by-name/persist          flags=display="Persist Image";backup=1;flashimg=1
/rescue          ext4    /dev/block/by-name/rescue           flags=display="Rescue"
/protect_f       ext4    /dev/block/by-name/protect1         flags=display="Protect F";backup=1
/protect_s       ext4    /dev/block/by-name/protect2         flags=display="Protect S";backup=1
/nvdata          ext4    /dev/block/by-name/nvdata           flags=display="NVData";backup=1
/nvcfg           ext4    /dev/block/by-name/nvcfg            flags=display="NVCFG";backup=1
/nvram           emmc    /dev/block/by-name/nvram            flags=display="NVRAM";backup=1
/proinfo         emmc    /dev/block/by-name/proinfo          flags=display="Proinfo";backup=1
/persistent      emmc    /dev/block/by-name/frp              flags=display="FRP (Persistent)"
/bootloader      emmc    /dev/block/by-name/lk               flags=display="Bootloader (LK)";slotselect;backup=1

# Removable Storage
/external_sd     auto    /devices/platform/externdevice* flags=display="MicroSD Card";storage;wipeingui;removable;fsflags="utf8"
/usb-otg         auto    /devices/platform/mt_usb* flags=display="USB-Storage";storage;wipeingui;removable;fsflags="utf8"
